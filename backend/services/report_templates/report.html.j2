<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ assessment.name }} — AIDA Security Report</title>
<style>{{ css | safe }}</style>
</head>
<body>

{# ===================== COVER PAGE ===================== #}
<div class="cover">
  <div class="cover-accent-top"></div>

  {# --- top zone: brand --- #}
  <div class="cover-brand-block">
    {% if logo_b64 %}<img class="cover-logo" src="{{ logo_b64 }}" alt="AIDA">{% endif %}
    <div class="cover-brand">AIDA</div>
    <div class="cover-brand-tagline">AI-Driven Security Assessment</div>
  </div>

  {# --- middle zone: title --- #}
  <div class="cover-title-block">
    <hr class="cover-line">
    <h1>Security Assessment<br>Report</h1>
    <div class="cover-subtitle">{{ assessment.name }}</div>
    {% if risk_score and risk_score != 'INFORMATIONAL' %}
    {% set risk_bg = {"CRITICAL":"#881337","HIGH":"#9f1239","MEDIUM":"#92400e","LOW":"#1e3a8a"} %}
    <div class="cover-risk-tag" style="background:{{ risk_bg.get(risk_score, '#334155') }};color:#fff">
      Overall risk · {{ risk_score }}
    </div>
    {% endif %}
  </div>

  {# --- bottom zone: meta grid --- #}
  <div class="cover-meta-grid">
    <table>
      <tbody>
        {% if assessment.client_name %}
        <tr>
          <td class="cover-meta-label">Client</td>
          <td class="cover-meta-value">{{ assessment.client_name }}</td>
        </tr>
        {% endif %}
        {% if assessment.category %}
        <tr>
          <td class="cover-meta-label">Category</td>
          <td class="cover-meta-value">{{ assessment.category }}</td>
        </tr>
        {% endif %}
        {% if assessment.target_domains %}
        <tr>
          <td class="cover-meta-label">Target</td>
          <td class="cover-meta-value">{{ assessment.target_domains | join(", ") }}</td>
        </tr>
        {% endif %}
        {% if assessment.start_date %}
        <tr>
          <td class="cover-meta-label">Engagement</td>
          <td class="cover-meta-value">{{ assessment.start_date }} — {{ assessment.end_date or "Ongoing" }}</td>
        </tr>
        {% endif %}
        <tr>
          <td class="cover-meta-label">Status</td>
          <td class="cover-meta-value">{{ assessment.status or "Active" }}</td>
        </tr>
        <tr>
          <td class="cover-meta-label">Issued</td>
          <td class="cover-meta-value">{{ generated_at }}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="cover-footer">
    <span class="cover-footer-mark">CONFIDENTIAL</span>
    This document is intended solely for the named recipient. Generated by AIDA — AI-Driven Assessment.
  </div>
</div>

{# ===================== TABLE OF CONTENTS ===================== #}
{# Pre-compute section numbers based on which sections will render #}
{% set section_numbers = {} %}
{% set ns = namespace(n=0) %}
{% set ns.n = ns.n + 1 %}{% set _ = section_numbers.update({"exec":   "%02d" % ns.n}) %}
{% if findings %}     {% set ns.n = ns.n + 1 %}{% set _ = section_numbers.update({"find":   "%02d" % ns.n}) %}{% endif %}
{% if observations %} {% set ns.n = ns.n + 1 %}{% set _ = section_numbers.update({"obs":    "%02d" % ns.n}) %}{% endif %}
{% if methodology_html %} {% set ns.n = ns.n + 1 %}{% set _ = section_numbers.update({"meth": "%02d" % ns.n}) %}{% endif %}
{% if recon %}        {% set ns.n = ns.n + 1 %}{% set _ = section_numbers.update({"recon":  "%02d" % ns.n}) %}{% endif %}
{% if credentials %}  {% set ns.n = ns.n + 1 %}{% set _ = section_numbers.update({"cred":   "%02d" % ns.n}) %}{% endif %}
{% if info_cards %}   {% set ns.n = ns.n + 1 %}{% set _ = section_numbers.update({"info":   "%02d" % ns.n}) %}{% endif %}

<div class="toc">
  <h2>Table of Contents</h2>
  <div class="toc-item"><a href="#exec-summary"><span class="toc-num">{{ section_numbers["exec"] }}</span> Executive Summary</a></div>

  {% if findings %}
  <div class="toc-item"><a href="#findings"><span class="toc-num">{{ section_numbers["find"] }}</span> Findings ({{ total_findings }})</a></div>
  {% for f in findings %}
  <div class="toc-sub">
    <a href="#finding-{{ loop.index }}">
      <span class="toc-sub-num">{{ section_numbers["find"] }}.{{ loop.index }}</span>
      <span class="toc-sub-sev" style="background:{{ severity_colors.get(f.severity or 'INFO', '#64748b') }}">{{ f.severity or "INFO" }}</span>
      {{ f.title }}
    </a>
  </div>
  {% endfor %}
  {% endif %}

  {% if observations %}
  <div class="toc-item"><a href="#observations"><span class="toc-num">{{ section_numbers["obs"] }}</span> Observations ({{ total_observations }})</a></div>
  {% endif %}

  {% if methodology_html %}
  <div class="toc-item"><a href="#methodology"><span class="toc-num">{{ section_numbers["meth"] }}</span> Methodology</a></div>
  {% endif %}

  {% if recon %}
  <div class="toc-item"><a href="#recon"><span class="toc-num">{{ section_numbers["recon"] }}</span> Reconnaissance Data ({{ total_recon }})</a></div>
  {% endif %}

  {% if credentials %}
  <div class="toc-item"><a href="#credentials"><span class="toc-num">{{ section_numbers["cred"] }}</span> Credentials Discovered &amp; Used ({{ total_credentials }})</a></div>
  {% endif %}

  {% if info_cards %}
  <div class="toc-item"><a href="#info"><span class="toc-num">{{ section_numbers["info"] }}</span> Additional Information</a></div>
  {% endif %}
</div>

{# ===================== EXECUTIVE SUMMARY ===================== #}
<h2 id="exec-summary"><span class="section-num">{{ section_numbers["exec"] }}</span> Executive Summary</h2>

{% set risk_color = {
  "CRITICAL":"#e11d48",
  "HIGH":"#f43f5e",
  "MEDIUM":"#f59e0b",
  "LOW":"#3b82f6",
  "INFORMATIONAL":"#64748b"
} %}
<div class="risk-banner" style="color:{{ risk_color.get(risk_score, risk_color['INFORMATIONAL']) }}">
  <div class="risk-label">Overall Risk Level</div>
  <div class="risk-level">{{ risk_score }}</div>
  {% set crit_high = severity_counts.get("CRITICAL", 0) + severity_counts.get("HIGH", 0) %}
  {% if total_findings > 0 %}
  <div class="risk-summary">
    <strong>{{ total_findings }}</strong> finding{{ "s" if total_findings != 1 }} identified during the engagement{% if crit_high %}, of which <strong>{{ crit_high }}</strong> require immediate remediation (critical or high severity){% endif %}. See section {{ section_numbers.get("find", "02") }} for full technical details.
  </div>
  {% endif %}
</div>

<table class="stats-row">
  <tr>
    <td class="stat-card">
      <div class="stat-num" style="color:var(--accent-critical)">{{ total_findings }}</div>
      <div class="stat-label">Findings</div>
    </td>
    <td class="stat-card">
      <div class="stat-num" style="color:var(--primary)">{{ total_observations }}</div>
      <div class="stat-label">Observations</div>
    </td>
    <td class="stat-card">
      <div class="stat-num" style="color:var(--accent-low)">{{ total_recon }}</div>
      <div class="stat-label">Recon Items</div>
    </td>
    <td class="stat-card">
      <div class="stat-num" style="color:var(--accent-info)">{{ commands_count }}</div>
      <div class="stat-label">Commands Run</div>
    </td>
  </tr>
</table>

{% if severity_counts %}
<h3>Findings by Severity</h3>
<table class="sev-chart">
  {% for sev in ["CRITICAL","HIGH","MEDIUM","LOW","INFO"] %}
  {% set cnt = severity_counts.get(sev, 0) %}
  {% if cnt > 0 %}
  <tr>
    <td class="sev-chart-label-cell" style="color:{{ severity_colors[sev] }}">{{ sev }}</td>
    <td class="sev-chart-track">
      <div class="sev-chart-track-inner">
        <div class="sev-chart-fill" style="width:{{ (cnt / max_sev_count * 100)|int }}%;background:{{ severity_colors[sev] }}"></div>
      </div>
    </td>
    <td class="sev-chart-count-cell">{{ cnt }}</td>
  </tr>
  {% endif %}
  {% endfor %}
</table>
{% endif %}

{# Top findings preview — show up to 5 highest-severity findings as a snapshot #}
{% set top = findings[:5] %}
{% if top|length > 0 %}
<h3>Key Findings</h3>
<table class="top-findings">
  <thead>
    <tr>
      <th class="col-id">#</th>
      <th class="col-sev">Severity</th>
      <th>Title</th>
      <th class="col-target">Target</th>
      <th class="col-cvss">CVSS</th>
    </tr>
  </thead>
  <tbody>
  {% for f in top %}
    <tr>
      <td class="col-id">F-{{ loop.index }}</td>
      <td class="col-sev">
        <span class="top-sev-badge" style="background:{{ severity_colors.get(f.severity or 'INFO', '#64748b') }}">{{ f.severity or "INFO" }}</span>
      </td>
      <td><a href="#finding-{{ loop.index }}" style="color:var(--text);text-decoration:none">{{ f.title }}</a></td>
      <td class="col-target">{{ f.target_service or "—" }}</td>
      <td class="col-cvss">{{ "%.1f"|format(f.cvss_score) if f.cvss_score is not none else "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% if findings|length > top|length %}
<p class="text-muted" style="margin-top:-8px;font-size:8.5pt">
  Showing top {{ top|length }} of {{ findings|length }} findings — see section {{ section_numbers["find"] }} for the complete list.
</p>
{% endif %}
{% endif %}

{% if assessment.scope %}
<h3>Scope</h3>
<p>{{ assessment.scope }}</p>
{% endif %}

{% if assessment.target_domains %}
<h3>Target Domains</h3>
<p>{{ assessment.target_domains | join(", ") }}</p>
{% endif %}

{% if assessment.ip_scopes %}
<h3>IP Ranges</h3>
<p>{{ assessment.ip_scopes | join(", ") }}</p>
{% endif %}

{% if assessment.objectives %}
<h3>Objectives</h3>
<p>{{ assessment.objectives }}</p>
{% endif %}

{% if assessment.limitations %}
<h3>Limitations</h3>
<p>{{ assessment.limitations }}</p>
{% endif %}

{# ===================== FINDINGS ===================== #}
{% if findings %}
<div class="page-break"></div>
<h2 id="findings"><span class="section-num">{{ section_numbers["find"] }}</span> Findings</h2>

{% for f in findings %}
{% set sev_color = severity_colors.get(f.severity or 'INFO', '#64748b') %}
<div class="finding" id="finding-{{ loop.index }}">
  {# color on the wrapper is consumed by .finding-accent::before via currentColor #}
  <div class="finding-accent" style="color:{{ sev_color }}"></div>
  <div class="finding-header">
    <span class="finding-sev" style="background:{{ sev_color }}">{{ f.severity or "INFO" }}</span>
    <span class="finding-title">{{ f.title }}</span>
    <span class="finding-id">#F-{{ loop.index }}</span>
  </div>
  <div class="finding-meta">
    <table class="finding-meta-table">
      <tbody>
        {% if f.target_service %}
        <tr>
          <td class="fm-label">Target</td>
          <td class="fm-value" colspan="3">{{ f.target_service }}</td>
        </tr>
        {% endif %}
        <tr>
          {% if f.status %}
          <td class="fm-label">Status</td>
          <td class="fm-value" style="width:32%">{{ f.status }}</td>
          {% else %}
          <td colspan="2"></td>
          {% endif %}
          {% if f.cvss_score is not none %}
          {% set cvss_color = "#e11d48" if f.cvss_score >= 9.0 else "#f43f5e" if f.cvss_score >= 7.0 else "#f59e0b" if f.cvss_score >= 4.0 else "#3b82f6" %}
          <td class="fm-label">CVSS 4.0</td>
          <td class="fm-value">
            <span class="cvss-badge" style="background:{{ cvss_color }}">{{ "%.1f"|format(f.cvss_score) }}</span>
          </td>
          {% else %}
          <td colspan="2"></td>
          {% endif %}
        </tr>
        {% if f.cvss_vector %}
        <tr>
          <td class="fm-label">Vector</td>
          <td class="fm-value fm-mono" colspan="3">{{ f.cvss_vector }}</td>
        </tr>
        {% endif %}
      </tbody>
    </table>
  </div>

  {% if f.technical_analysis %}
  <div class="finding-field">
    <div class="field-label">Technical Analysis</div>
    <div class="md-content">{{ f.technical_analysis | markdown | safe }}</div>
  </div>
  {% endif %}

  {% if f.proof %}
  <div class="finding-field">
    <div class="field-label">Proof of Concept</div>
    <div class="md-content">{{ f.proof | markdown | safe }}</div>
  </div>
  {% endif %}

  {% if f.notes %}
  <div class="finding-field">
    <div class="field-label">Notes / Remediation</div>
    <div class="md-content">{{ f.notes | markdown | safe }}</div>
  </div>
  {% endif %}
</div>
{% endfor %}
{% endif %}

{# ===================== OBSERVATIONS ===================== #}
{% if observations %}
<div class="page-break"></div>
<h2 id="observations"><span class="section-num">{{ section_numbers["obs"] }}</span> Observations</h2>

{% for o in observations %}
<div class="obs-card">
  <h4>{{ o.title }}</h4>
  {% if o.target_service %}<p><strong>Target:</strong> {{ o.target_service }}</p>{% endif %}
  {% if o.technical_analysis %}<div class="md-content">{{ o.technical_analysis | markdown | safe }}</div>{% endif %}
  {% if o.notes %}<div class="md-content text-muted" style="margin-top:6px">{{ o.notes | markdown | safe }}</div>{% endif %}
</div>
{% endfor %}
{% endif %}

{# ===================== METHODOLOGY ===================== #}
{% if methodology_html %}
<div class="page-break"></div>
<h2 id="methodology"><span class="section-num">{{ section_numbers["meth"] }}</span> Methodology</h2>
<div class="md-content">
  {{ methodology_html | safe }}
</div>
{% endif %}

{# ===================== RECON ===================== #}
{% if recon %}
<div class="page-break"></div>
<h2 id="recon"><span class="section-num">{{ section_numbers["recon"] }}</span> Reconnaissance Data</h2>

{% set recon_by_type = {} %}
{% for r in recon %}
  {% if r.data_type not in recon_by_type %}
    {% set _ = recon_by_type.update({r.data_type: []}) %}
  {% endif %}
  {% set _ = recon_by_type[r.data_type].append(r) %}
{% endfor %}

{% for dtype, items in recon_by_type.items() %}
<div class="recon-type-heading">{{ dtype | replace("_"," ") | title }}<span class="recon-count">{{ items|length }} item{{ "s" if items|length != 1 }}</span></div>
<table class="recon-table">
  <colgroup>
    <col style="width:38%">
    <col style="width:62%">
  </colgroup>
  <tbody>
  {% for item in items[:50] %}
    <tr>
      <td class="recon-name">{{ item.name }}</td>
      <td class="recon-details">{{ item.details | recon_details }}</td>
    </tr>
  {% endfor %}
  {% if items|length > 50 %}
    <tr><td colspan="2" class="recon-more">… and {{ items|length - 50 }} more entries</td></tr>
  {% endif %}
  </tbody>
</table>
{% endfor %}
{% endif %}

{# ===================== CREDENTIALS ===================== #}
{% if credentials %}
<div class="page-break"></div>
<h2 id="credentials"><span class="section-num">{{ section_numbers["cred"] }}</span> Credentials Discovered &amp; Used</h2>

{% if include_secrets %}
<p class="cred-banner cred-banner-unmasked">
  <strong>SECRETS VISIBLE — this copy contains plaintext credentials.</strong>
  Passwords, tokens and cookies are embedded in clear text below. Treat this
  PDF as highly sensitive: encrypt at rest, restrict distribution, and rotate
  every credential before sharing externally.
</p>
{% endif %}

{% macro mask(value) -%}
  {%- if not value -%}{%- else -%}<span class="cred-redacted">[REDACTED — {{ value|length }} chars]</span>{%- endif -%}
{%- endmacro %}

{% for c in credentials %}
<div class="cred-entry">
  <div class="cred-header">
    <span class="cred-name">{{ c.name }}</span>
    <span class="cred-type">{{ c.credential_type }}</span>
  </div>

  <table class="cred-fields">
    <tbody>
      {% if c.username %}
      <tr><td class="cred-label">Username</td><td class="cred-value">{{ c.username }}</td></tr>
      {% endif %}
      {% if c.password %}
      <tr><td class="cred-label">Password</td><td class="cred-value">{% if include_secrets %}{{ c.password }}{% else %}{{ mask(c.password) }}{% endif %}</td></tr>
      {% endif %}
      {% if c.token %}
      <tr><td class="cred-label">Token</td><td class="cred-value cred-mono">{% if include_secrets %}{{ c.token }}{% else %}{{ mask(c.token) }}{% endif %}</td></tr>
      {% endif %}
      {% if c.cookie_value %}
      <tr><td class="cred-label">Cookie</td><td class="cred-value cred-mono">{% if include_secrets %}{{ c.cookie_value }}{% else %}{{ mask(c.cookie_value) }}{% endif %}</td></tr>
      {% endif %}
      {% if c.custom_data %}
      <tr><td class="cred-label">Custom</td><td class="cred-value cred-mono">{% if include_secrets %}{{ c.custom_data | tojson }}{% else %}<span class="cred-redacted">[REDACTED — JSON object with {{ c.custom_data|length }} key{{ "s" if c.custom_data|length != 1 }}]</span>{% endif %}</td></tr>
      {% endif %}
      {% if c.service %}
      <tr><td class="cred-label">Service</td><td class="cred-value">{{ c.service }}</td></tr>
      {% endif %}
      {% if c.target %}
      <tr><td class="cred-label">Target</td><td class="cred-value">{{ c.target }}</td></tr>
      {% endif %}
      {% if c.placeholder %}
      <tr><td class="cred-label">Placeholder</td><td class="cred-value cred-mono">{{ c.placeholder }}</td></tr>
      {% endif %}
      <tr><td class="cred-label">Discovered</td><td class="cred-value">{{ c.discovered_by or "manual" }}</td></tr>
      {% if c.notes %}
      <tr><td class="cred-label">Notes</td><td class="cred-value">{{ c.notes }}</td></tr>
      {% endif %}
    </tbody>
  </table>
</div>
{% endfor %}
{% endif %}

{# ===================== INFO CARDS ===================== #}
{% if info_cards %}
<div class="page-break"></div>
<h2 id="info"><span class="section-num">{{ section_numbers["info"] }}</span> Additional Information</h2>

{% for i in info_cards %}
<div class="info-card">
  <h4>{{ i.title }}</h4>
  {% if i.technical_analysis %}<div class="md-content">{{ i.technical_analysis | markdown | safe }}</div>{% endif %}
  {% if i.notes %}<div class="md-content text-muted" style="margin-top:6px">{{ i.notes | markdown | safe }}</div>{% endif %}
</div>
{% endfor %}
{% endif %}

{# ===================== AI DISCLAIMER (always last) ===================== #}
{# Force the disclaimer onto a dedicated final page so it always closes
   the report cleanly. The .ai-disclaimer-wrap fills the page with the
   notice anchored at the bottom — gives the report a deliberate, signed
   ending instead of dangling under whatever section finished last. #}
<div class="ai-disclaimer-page">
  <div class="ai-disclaimer">
    <div class="ai-disclaimer-title">Notice — AI-assisted assessment</div>
    <p>
      This report was generated with the assistance of AIDA, an AI-driven
      security assessment platform. AI can make mistakes: findings, severities,
      recommendations, and reasoning may contain errors, hallucinations, or
      omissions.
    </p>
    <p>
      Please double-check every finding against the raw evidence (commands,
      payloads, output) before relying on this report for remediation,
      disclosure, or regulatory purposes. A qualified human reviewer should
      validate the report before distribution.
    </p>
  </div>
</div>

</body>
</html>
